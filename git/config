[push]
  default = simple

[alias]
  co = checkout
  ci = commit
  st = status
  fe = fetch
  br = branch
  pl = pull
  df = diff
  ls = log --oneline -n 20 --graph
  ship = "!f() { \
	  before=$(git rev-parse HEAD) && \
	  claude -p \"/commit\" && \
	  after=$(git rev-parse HEAD) && \
	  if [ \"$before\" != \"$after\" ]; then \
		  git push; \
	  else \
		  echo \"No new commit created; skipping push.\"; \
	  fi; \
  }; f"
  sh = !git ship

[core]
  excludesfile = /home/bart/.gitignore_global
	hooksPath = /home/bart/.config/git/hooks

[credential]
  helper = store

[init]
  defaultBranch = main

