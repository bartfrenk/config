[push]
  default = simple

[alias]
  co = checkout
  ci = commit
  st = status
  fe = fetch
  br = branch
  pl = pull
  df = diff
  ls = log --oneline -n 20 --graph
  ship = "!~/.local/bin/git-ship"
  sh = !git ship

[core]
  excludesfile = /home/bart/.gitignore_global
	hooksPath = /home/bart/.config/git/hooks

[credential]
  helper = store

[init]
  defaultBranch = main

